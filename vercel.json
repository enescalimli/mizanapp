  "framework": "nextjs",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/.next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/live-market",
      "schedule": "0 16 * * *"
    }
  ]
}
