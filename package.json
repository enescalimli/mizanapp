  "private": true,
  "description": "Katılım Finansmanı Screening, Bilanço Analizi, Portföy Arındırma ve Piyasa Takip Platformu",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
