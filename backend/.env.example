# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Katilim Finansmani Platformu"
API_V1_PREFIX=/api/v1
PORT=8000

# Database Settings
# For local development with PostgreSQL/TimescaleDB
DATABASE_URL=postgresql+asyncpg://katilim_user:katilim_password@localhost:5432/katilim_db
DATABASE_URL_SYNC=postgresql://katilim_user:katilim_password@localhost:5432/katilim_db

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# Security / JWT
SECRET_KEY=katilim_super_secret_jwt_key_for_development_purposes_only_32bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Screening Defaults
DEFAULT_STANDARD_CODE=BIST_KATILIM_DIB
